{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "next/link": ["./src/shims/next-link.tsx"],
      "next/image": ["./src/shims/next-image.tsx"],
      "next/dynamic": ["./src/shims/next-dynamic.tsx"],
      "next/navigation": ["./src/shims/next-navigation.ts"],
      "next/server": ["./src/shims/next-server.ts"],
      "next/headers": ["./src/shims/next-headers.ts"],
      "next/script": ["./src/shims/next-script.tsx"],
      "next/font/google": ["./src/shims/next-font.ts"],
      "next/head": ["./src/shims/next-head.tsx"],
      "next/cache": ["./src/shims/next-cache.ts"]
    },
    "module": "esnext",
    "types": ["astro/client"]
  },
  "include": ["src/**/*", "astro.config.mjs"],
  "exclude": ["node_modules", "dist"]
}
