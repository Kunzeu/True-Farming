---
import Layout from '@/layouts/Layout.astro';
import Island from '@/islands/legendary-tracker';

const langCookie = Astro.cookies.get('tf_lang')?.value;
const lang =
  langCookie === 'de' || langCookie === 'es' || langCookie === 'fr' || langCookie === 'en'
    ? langCookie
    : 'en';
---

<Layout showNav={true} title={"Legendary Tracker - True Farming"} description={"True Farming - Guild Wars 2 tools for farming routes, salvage, festivals, legendary tracker and more."}>
  <Island client:load lang={lang} />
</Layout>
